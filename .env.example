# Public browser configuration only. Default is same-origin /api/v1/.
# Set a complete HTTPS API URL for a separately hosted learner/native client.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase configuration is added when a dedicated development project is connected.
# Never prefix a secret/service-role key with VITE_ or NEXT_PUBLIC_.
